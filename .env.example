# Copy to ".env" for local work. For Heroku add the same names as Config Vars.
# Values below are examples. Never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/ranaswanu
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=change-me-at-least-32-characters-long-random-text
