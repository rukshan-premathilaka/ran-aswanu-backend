MAIL_PASSWORD=
FRONTEND_RESET_URL=http://localhost:5173/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLOUDINARY_URL=
SHOW_SQL=false

# Heroku production example (set with: heroku config:set NAME=value)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# FRONTEND_RESET_URL=https://your-app.vercel.app/reset-password
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# (DB_* are NOT needed on Heroku: the Postgres add-on provides the database settings)
